{
  "name": "betocampoy/champs-whatsapp-sdk",
  "description": "SDK PHP da Champs para o gateway WhatsApp (champs-whatsapp-gateway): sessões, QR code, envio de mensagens e regras do protocolo. Sem regra de negócio de nenhuma aplicação.",
  "type": "library",
  "license": "MIT",
  "keywords": ["whatsapp", "baileys", "gateway", "champs"],
  "authors": [
    {
      "name": "Beto Campoy"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/http-client": "^6.4 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "BetoCampoy\\Champs\\WhatsappSdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BetoCampoy\\Champs\\WhatsappSdk\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
